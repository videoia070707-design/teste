# Canonical application origin. Used to construct OAuth callbacks safely.
APP_ORIGIN=

# Supabase Auth. The publishable key is safe for the browser when RLS/auth rules are correct.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database (server only)
DATABASE_URL=

# Meta / Instagram (server only unless explicitly documented otherwise)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SIGNATURE_HEADER=x-hub-signature-256

# Keep API version explicit. Do not silently upgrade provider behavior.
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_IDENTITY_PROBE_PATH=

# OAuth endpoints are configuration, not domain constants.
INSTAGRAM_OAUTH_AUTHORIZE_URL=
INSTAGRAM_OAUTH_TOKEN_URL=
INSTAGRAM_OAUTH_TOKEN_ENCODING=multipart
INSTAGRAM_REDIRECT_URI=

# Never prefix secrets above with NEXT_PUBLIC_.
