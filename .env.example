# Canonical application origin. Used by the hosted web dashboard and portable
# OAuth callback fallback. During local HOST PASS this may be http://localhost:3000.
APP_ORIGIN=

# Hosted production legal/App Review identity lives in
# app_private.platform_public_config and is served by Supabase Edge.
# These remain OPTIONAL portable/self-hosting fallbacks only.
# LEGAL_ENTITY_NAME=
# SUPPORT_EMAIL=

# Supabase Auth. The publishable key is safe for browser use when authorization
# rules are correct, but the hosted Blueprint keeps it operator-supplied so no
# key-like value is committed in deploy config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in stays disabled until the Google provider is configured in Supabase
# and its redirect URI is validated in the Google OAuth client.
GOOGLE_AUTH_ENABLED=false

# Database (server only for the Next.js web app / optional Docker fallback).
# Hosted G3 web MUST use the dedicated `automation_web` login created by the
# Supabase adapter migration, not the `postgres` project administrator role.
# On the shared Supavisor pooler the username is:
#   automation_web.<PROJECT_REF>
# For an IPv4-only host, use the shared Supavisor pooler with sslmode=require.
# Copy the exact pooler hostname from the Supabase Connect dialog; never guess it.
DATABASE_URL=
# Keep the single free web service conservative. Increase only from observed load.
DATABASE_POOL_MAX=3

# Provider credential encryption.
# DEFAULT on the Supabase Free runtime: keyring is read server-side from the
# Supabase Vault secret `provider_secret_keyring` created by migration 014.
# The variables below are OPTIONAL legacy/self-hosting fallback only. If one is
# supplied, both must be supplied. Never expose them with NEXT_PUBLIC_.
# PROVIDER_SECRET_CURRENT_KEY_VERSION=v1
# PROVIDER_SECRET_KEYS_JSON={"v1":"<base64-encoded-32-byte-key>"}

# Meta / Instagram — hosted production source of truth:
# - secrets live in Supabase Vault;
# - non-secret App/API configuration lives in app_private.provider_runtime_config.
# The environment variables below are ONLY portable/self-hosting fallbacks and
# MUST NOT be declared in render.yaml for the hosted G3 path.
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_WEBHOOK_SIGNATURE_HEADER=x-hub-signature-256
# INSTAGRAM_GRAPH_BASE_URL=
# INSTAGRAM_GRAPH_API_VERSION=
# INSTAGRAM_IDENTITY_PROBE_PATH=
# INSTAGRAM_OAUTH_AUTHORIZE_URL=
# INSTAGRAM_OAUTH_TOKEN_URL=
# INSTAGRAM_OAUTH_TOKEN_ENCODING=multipart
# INSTAGRAM_LONG_LIVED_TOKEN_URL=

# Do not seed legacy Instagram Basic Display OAuth endpoints by assumption.
# The hosted row remains incomplete until endpoints are validated against the
# real Meta App and current Instagram Login configuration.

# Optional Docker fallback workers. They are NOT required by the G3 Free runtime.
INGRESS_WORKER_BATCH_SIZE=10
INGRESS_WORKER_POLL_MS=1000
INGRESS_WORKER_LEASE_SECONDS=60
INGRESS_WORKER_ID=
OUTBOUND_WORKER_BATCH_SIZE=10
OUTBOUND_WORKER_POLL_MS=750
OUTBOUND_WORKER_LEASE_SECONDS=45
OUTBOUND_WORKER_ID=

# Supabase Edge runtime does not require a committed scheduler token or database
# password: SUPABASE_DB_URL is injected by Supabase and the invocation token lives
# in Supabase Vault / app_private.runtime_invocation_tokens.

# Never prefix server secrets above with NEXT_PUBLIC_.
