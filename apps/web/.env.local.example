# G3 HOST PASS local dashboard — optional Next.js path
# The primary G3 HOST PASS surface is tools/g3-console and does NOT need DATABASE_URL.
# Copy this file to apps/web/.env.local only when running the full Next.js dashboard locally.
# Never commit the resulting .env.local.

APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://cqtrigqlktekczbbsxiy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YvoQENFFqgNkiH2xZxBB5Q_vb0kNyS_
GOOGLE_AUTH_ENABLED=false

# Optional full-dashboard DB connection.
# Use the exact Shared Pooler host shown by Supabase Dashboard → Connect.
# Do NOT infer aws-0/aws-1/etc. from the region; the pooler cluster index varies by project.
# Username for this project's least-privilege role: automation_web.cqtrigqlktekczbbsxiy
# Session Pooler port: 5432. Production/public transport must use TLS.
# Percent-encode reserved URL characters in the password.
DATABASE_URL=postgresql://automation_web.cqtrigqlktekczbbsxiy:<AUTOMATION_WEB_PASSWORD>@<SUPABASE_POOLER_HOST>:5432/postgres?sslmode=require

# Provider secrets are intentionally absent.
# Meta App Secret, webhook verify token, and provider AES keyring live in Supabase Vault.
# Meta App ID / OAuth endpoints / legal identity are configured through the G3 Console / Setup Center.
